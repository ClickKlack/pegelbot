{
    "name": "clickklack/pegelbot",
    "description": "Bot, der Wasserstände der Elbe von PEGELONLINE abruft, historisiert und über mehrere Kanäle veröffentlicht, samt webbasiertem Log-Betrachter.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "abraham/twitteroauth": "^6.2",
        "cjrasmussen/bluesky-api": "^1.1",
        "doctrine/dbal": "^3.7",
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.5",
        "phpmailer/phpmailer": "^6.9",
        "psr/clock": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "LogViewer\\": "logviewer/src/",
            "PegelBot\\": "bot/src/",
            "WSA\\": "bot/src/wsa/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.24"
        }
    }
}
