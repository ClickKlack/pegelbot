{
    "name": "clickklack/pegelbot",
    "description": "Entwicklungswerkzeuge und Testrahmen des Gesamtprojekts. Die Laufzeit-Abhaengigkeiten des Bots stehen in bot/composer.json, weil bot/ und logviewer/ getrennt ausgerollt werden.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.5",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "LogViewer\\": "logviewer/src/",
            "PegelBot\\": "bot/src/",
            "WSA\\": "bot/src/wsa/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
