# ============================================================================
#  Absicherung des Dokumentenstamms des Log-Betrachters.
#
#  Die Anmeldung selbst laeuft ueber das Formular in index.php, nicht ueber den
#  Webserver. Diese Datei enthaelt deshalb keine serverspezifischen Pfade und
#  kann versioniert werden.
# ============================================================================

# Keine Verzeichnisauflistung
Options -Indexes

DirectoryIndex index.php

# Punktdateien sperren.
#
# ACHTUNG: Das Muster darf nicht auf die leere Zeichenkette passen. Eine
# fruehere Fassung sperrte mit "^(?!index\.php$).*$" alles ausser index.php -
# das traf auch die Anfrage auf das Verzeichnis selbst, bei der der Dateiname
# leer ist. Apache verweigerte dadurch mit 403, bevor DirectoryIndex ueberhaupt
# zu index.php aufloesen konnte.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
