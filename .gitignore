# ============================================================================
#  Pegelbot - nicht zu versionierende Dateien
# ============================================================================

# --- Konfiguration mit Zugangsdaten -----------------------------------------
# Zu jeder dieser Dateien gehoert eine versionierte Vorlage
/bot/config/pegelbot-config.php
/logviewer/config.php

# --- Zugriffsschutz des Log-Betrachters -------------------------------------
# AuthUserFile verlangt einen absoluten Pfad, deshalb ist die fertige .htaccess
# serverspezifisch. Vorlage: logviewer/public/.htaccess.sample
/logviewer/public/.htaccess
/logviewer/.htpasswd

# --- Composer-Artefakte -----------------------------------------------------
/vendor/
/bot/vendor/

# --- Laufzeitdaten ----------------------------------------------------------
# Die Verzeichnisse selbst bleiben erhalten, damit sie beim Ausrollen
# vorhanden sind - der Bot legt sie nicht selbst an.
/bot/logs/*
!/bot/logs/.gitkeep
/bot/tmp/*
!/bot/tmp/.gitkeep

# --- Datenbankauszuege ------------------------------------------------------
# Auszuege der Abonnement-Tabellen enthalten Zugangsdaten im Klartext
# und duerfen das Projekt nicht verlassen. Siehe SPEC.md, Befund S8.
/dumps/
*.dump.sql
*.sql.gz

# --- Betriebssystem und Editoren --------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~

# --- Testwerkzeuge ----------------------------------------------------------
/.phpunit.cache/
/.phpunit.result.cache
/coverage/
